class Main {
    public static void main(String[] args) {
        int n = 6;

        for (int i = 1; i <= n; i++) {
            int val = i % 2;

            for (int j = 1; j <= i; j++) {
                System.out.print(val + " ");
                val = (val == 0) ? 1 : 0;
            }

            System.out.println();
        }
    }
}
